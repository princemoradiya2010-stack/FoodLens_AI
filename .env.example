# ============================================================
# FoodLens AI - Backend Environment Variables
# ============================================================

# Port for the FastAPI server (Render automatically sets $PORT)
PORT=8000

# Path to the SQLite database file (can be pointed to a persistent disk on Render)
DATABASE_PATH=foodlens.db

# Path to the trained YOLO weights file
MODEL_PATH=models/foodlens_yolo11s_best.pt

# Temporary folder for image uploads
UPLOAD_DIR=uploads

# Allowed CORS origins (comma-separated). Set to * to allow all origins, or list domains:
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,https://your-foodlens-app.vercel.app

# Regex pattern for allowed origins (defaults to matching any *.vercel.app deployment)
ALLOWED_ORIGIN_REGEX=^https://.*\.vercel\.app$
